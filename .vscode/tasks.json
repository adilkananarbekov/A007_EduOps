{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Run on Android Device",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Flutter: Run on iOS",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "iPhone"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Flutter: Run on Windows",
      "type": "shell",
      "command": "flutter",
      "args": [
        "run",
        "-d",
        "windows"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    },
    {
      "label": "Flutter: Pub Get",
      "type": "shell",
      "command": "flutter",
      "args": [
        "pub",
        "get"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Flutter: List Devices",
      "type": "shell",
      "command": "flutter",
      "args": [
        "devices"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Flutter: Get Device Info (run this first)",
      "type": "shell",
      "command": "flutter",
      "args": [
        "devices",
        "-v"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
